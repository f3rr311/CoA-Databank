  "tooltip_enus": "<table><tr><td><table width=\"100%\"><tr><td><b>Warden's Blade</b></td><th><b class=\"q0\">Rank 1</b></th></tr></table>5% of base mana<br /><table width=\"100%\"><tr><td>Instant</td><th>20&nbsp;sec cooldown</th></tr></table></td></tr></table><table><tr><td>Requires Melee Weapon<br /><span class=\"q\">Attack with celestial fervor, dealing 150% Weapon Damage and triggering a unique effect based on your active <span style=\"color: #ffffff;\">Aspect</span>.<br /><span class='iconsmall'><ins style='background-image: url(\"https://db.ascension.gg/static/images/wow/icons/small/achievement_zone_newshadowmoonvalley.jpg\");'></ins><del></del></span>\n                            <a style='color: white !important' href='?spell=805512'> Cosmic Renewal (Aspect of the Moonwell) </a> <br />\n                            <span> Regenerates 30% of your maximum mana.</span><br /><br /><span class='iconsmall'><ins style='background-image: url(\"https://db.ascension.gg/static/images/wow/icons/small/ability_upgrademoonglaive.jpg\");'></ins><del></del></span>\n                            <a style='color: white !important' href='?spell=805511'> Warden's Strike (Aspect of the Warden) </a> <br />\n                            <span> Reduces healing done to the enemy by 40% for 8&nbsp;sec.</span><br /><br /><span class='iconsmall'><ins style='background-image: url(\"https://db.ascension.gg/static/images/wow/icons/small/spell_nature_moonglow.jpg\");'></ins><del></del></span>\n                            <a style='color: white !important' href='?spell=805510'> Star Sear (Aspect of the Stars) </a> <br />\n                            <span> Increases the damage of your <span style=\"color: #ffffff;\">Lunar Lance</span> by 25%.</span><br /><br /><span class='iconsmall'><ins style='background-image: url(\"https://db.ascension.gg/static/images/wow/icons/small/inv_misc_questionmark.jpg\");'></ins><del></del></span>\n                            <a style='color: white !important' href=