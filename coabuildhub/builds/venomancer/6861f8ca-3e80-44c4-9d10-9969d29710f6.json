 "build": {
  "id": "6861f8ca-3e80-44c4-9d10-9969d29710f6",
  "title": "Venomancer (Vizier) - Healing leveling/dungeons build",
  "description": "[overview]\nTalents are built around mana regen, critical strike heals and extra healing for HoT spells.\n\n[stats]\nStack as much INT and Spell Power as possible with some Spirit if possible.\nINT = more mana.\nSpell power = better heals.\nSpirit helps with mana regen.\n\n[gear]\nMail if possible, but I would get the gear based on stats and not on type. If a cloth items has better stats, then use it.",
  "class_id": 29,
  "spec_id": 92,
  "author_id": "22e1c7dc-6ae6-4158-a392-de106c22bfab",
