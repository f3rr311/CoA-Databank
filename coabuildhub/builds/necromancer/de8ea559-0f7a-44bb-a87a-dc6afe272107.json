 "comments": [
  {
   "id": "00e316a0-5a4d-40e9-8231-f8c9cb224847",
   "build_id": "de8ea559-0f7a-44bb-a87a-dc6afe272107",
   "author_id": "5b42d0bb-333b-4704-9c9e-a2f8b4e0a8b2",
   "parent_id": null,
   "body": "best minions for dungeon and open world ?",
   "upvotes": 0,
   "created_at": "2026-07-20T22:53:43.690097+00:00",
   "updated_at": "2026-07-20T22:53:43.690097+00:00",
   "downvotes": 0,
   "hidden": false,
   "author": {
    "id": "5b42d0bb-333b-4704-9c9e-a2f8b4e0a8b2",
    "username": "kumeno0963",
    "avatar_url": "https://cdn.discordapp.com/avatars/1427774330053591092/6d25f2e10937c2cea65b32aa55e72a46.png"
   }
  },
  {
   "id": "b97a911f-00e1-4bfa-8d81-2bd0f97564d8",
   "build_id": "de8ea559-0f7a-44bb-a87a-dc6afe272107",
   "author_id": "3f4f5a34-7a14-485e-bc1b-25e50c71e057",
   "parent_id": "00e316a0-5a4d-40e9-8231-f8c9cb224847",
   "body": "Open World (usually solo questing): I usually run with abomination & ghouls. ghouls will give life leech, both cover AoE. I've been trying out Bone Wraith/Tomb King, think i like Tomb King better (increases overall damage vs AoE, but if you need more, summon Plaguefather & spam command more with all of the pets). \nGroups/Dungeons: I change it up based on how well the tank holds aggro/takes a beating. Most of the time i use a mix of ghouls and rogues (rogues hit hard for command finishers). If AoE is needed for large pulls i'll use Plaguefather + Corpse Explosion. I sometimes use Crypt Fiends if I know the mobs/bosses do a melee aoe/cleave.\nIf the tank is struggling, i'll pull out a skeleton warrior until aggro gets under control. If tank dies, i'll call in the abomination + ghouls then channel life into pets as they hold aggro & life steal to me. pop other summons to help get things under control.",
   "upvotes": 0,
   "created_at": "2026-07-21T19:00:46.483726+00:00",
