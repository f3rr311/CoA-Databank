 "comments": [
  {
   "id": "80353f1f-c76f-44ca-b48b-77ae57149f75",
   "build_id": "e4f93380-6b16-429b-abf6-7add7b0fb7b6",
   "author_id": "01f3e7f9-c348-45a6-85d2-1e1a82b2d21d",
   "parent_id": null,
   "body": "Can you explain the logic behind taking douse vs flourishing growth ?",
   "upvotes": 1,
   "created_at": "2026-07-19T11:10:25.895547+00:00",
   "updated_at": "2026-07-20T08:58:11.456152+00:00",
   "downvotes": 0,
   "hidden": false,
   "author": {
    "id": "01f3e7f9-c348-45a6-85d2-1e1a82b2d21d",
    "username": "Meshal Al-Sunbel",
    "avatar_url": "https://lh3.googleusercontent.com/a/ACg8ocJ--mGFccaZPs68jfrNPM7Grrz9Y8LR6nQU1VRokTFVMjEZeA=s96-c"
   }
  },
  {
   "id": "b32453ad-1291-4d97-b79a-d8f8da758bd5",
   "build_id": "e4f93380-6b16-429b-abf6-7add7b0fb7b6",
   "author_id": "b1705e47-62cb-4c97-b845-a2fb66c34bfa",
   "parent_id": "80353f1f-c76f-44ca-b48b-77ae57149f75",
   "body": "Both buffs are powerful and you should take different ones depending on the situation. Douse is completely passive, so if you are say the main healer for your party then you might not have the time to cast Flourishing. If you are DPS/support role in a party full of spellcasters then Flourishing can be better than Douse as it gives a large amount of spell power.",
