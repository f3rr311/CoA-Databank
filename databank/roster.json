      "disposition": "preserve-all-distinct-named-specs",
      "evidence": [
        {
          "source": "C:\\TrinityBots\\AscensionArchive\\CoA-Class-Roster.md",
          "finding": "The archive summary asserts 21 classes / 69 specs but does not enumerate the specs."
        },
        {
          "source": "C:\\TrinityBots\\AscensionArchive\\archive\\coa_classes\\*.txt",
          "finding": "The 21 captured class-guide specialization blocks enumerate 70 named specs: fourteen classes list three and seven classes list four."
        },
        {
          "source": "C:\\COA\\qa\\data\\branch-spec-lines.json",
          "finding": "The recovered client DBC exposes three contiguous historical skill lines per class; it also records that seven fourth specs are absent from that older extract, so 63 DBC lines cannot disprove the later 70-name guide roster."
        }
      ]
    }
  },
  "evidence": {
    "archive-class-guides-2026-07": {
      "tag": "DOCUMENTED",
      "source": "C:\\TrinityBots\\AscensionArchive\\archive\\coa_classes\\*.txt",
      "finding": "The captured July 2026 class-guide specialization blocks directly describe the combat job, mechanic, resource, armor affinity, and fantasy of all 70 named specs."
    },
    "ascension-packleader-tank": {
      "tag": "DOCUMENTED",
      "source": "https://ascension.gg/en/changelog/4?page=116",
      "finding": "Ascension names Ravenous Bite Packleader among the tank-threat abilities and records Bloodmage among specs using the baseline tank threat modifier; an older changelog also records a Packleader node replacing Eternal Curse, the captured tank-stance spell."
    },
    "ascension-current-tank-specs": {
      "tag": "DOCUMENTED",
      "source": "https://ascension.gg/en/changelog/2026/04/28",
      "finding": "The 2026-07-18 official changelog explicitly names Moon Guard, Seraphim, Mountain King, Fortitude, Defiance, Vanguard, Black Knight, and Dreadnought while adjusting their tank threat auras, and identifies Tyrant as a tank in the 2026-07-13 fix."
    },
    "ascension-starcaller-role-split": {
      "tag": "DOCUMENTED",
      "source": "https://ascension.gg/en/changelog/4?page=149",
      "finding": "Ascension documents splitting Astral Warfare into Warden and Moon Guard; subsequent official changes place defensive and threat mechanics in Moon Guard and offensive blade mechanics in Warden."
    },
    "starcaller-warden-dps-adjudication": {
      "tag": "INFERENCE",
      "source": "https://ascension.gg/en/changelog/4?page=149 and https://ascension.gg/en/changelog/2026/04/28",
      "finding": "Warden is adjudicated as melee DPS and Moon Guard as tank after their source tree was split.",
      "reasoning": "The official split moves bulwark, resilience, avoidance, and later an explicit tank-threat aura into Moon Guard, while Warden receives offensive blade, precision, onslaught, and lethal-pursuit nodes. This supersedes the captured fan guide's stale sentence that calls Warden the tank."
    },
    "ascension-sun-cleric-role-split": {
      "tag": "DOCUMENTED",
      "source": "https://ascension.gg/pt/changelog/4?page=151",
      "finding": "Ascension documents splitting the old Seraphim dual role into Seraphim and Valkyrie; the current threat-aura changelog identifies Seraphim as the tank, leaving Valkyrie as the melee DPS path described by the captured guide."
    }
  },
